# Required. Clients send it in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

REDIS_URL=redis://localhost:6379/0
WHISPER_MODEL=base
UPLOAD_DIR=/tmp/transcription_uploads

# Limits
MAX_UPLOAD_MB=100
MAX_AUDIO_SECONDS=3600

# Longest audio window per Whisper call; chunks end at a segment boundary
CHUNK_SECONDS=60

# Subprocess timeouts
FFPROBE_TIMEOUT_SECONDS=30
FFMPEG_TIMEOUT_SECONDS=600

# Job lifecycle
JOB_TTL_SECONDS=86400
LOCK_TIMEOUT_SECONDS=900
VISIBILITY_TIMEOUT_SECONDS=7200
ORPHAN_UPLOAD_MIN_AGE_SECONDS=3600

# Docker Compose only. API_BIND=0.0.0.0 makes the API reachable from your network.
API_BIND=127.0.0.1
API_PORT=8000
WORKER_CONCURRENCY=1
